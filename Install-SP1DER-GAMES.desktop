[Desktop Entry]
Version=1.0
Type=Application
Name=Install SP1DER GAMES
Comment=Build and install SP1DER GAMES
Exec=bash -c 'DESK_DIR="$(dirname "$(realpath "$1")")"; TARGET=$(find "$DESK_DIR" "$HOME/Downloads" -maxdepth 2 -name "install.sh" 2>/dev/null | head -n 1); if [ -n "$TARGET" ]; then cd "$(dirname "$TARGET")"; chmod +x ./install.sh && ./install.sh; else echo "Error: Could not locate install.sh in $DESK_DIR or Downloads."; echo ""; read -p "Press Enter to exit..."; exit 1; fi; echo ""; read -p "Press Enter to exit..."' dummy %k
Icon=utilities-terminal
Terminal=true
Categories=Development;